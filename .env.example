# Copy to .env and adjust. .env is git-ignored; this file is the documented template.

# --- Application ---
PROJECT_NAME="Owsify API"
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# Either set the discrete POSTGRES_* values, or set DATABASE_URL to override them all.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=splitwise
POSTGRES_PASSWORD=splitwise
POSTGRES_DB=splitwise
# DATABASE_URL=postgresql+psycopg2://splitwise:splitwise@localhost:5433/splitwise
SQL_ECHO=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-before-deploying-anywhere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# --- Email ---
# console = log the message (default, no setup needed and the invite link shows
#           up in the server log), file = write .eml files, smtp = really send.
EMAIL_BACKEND=console
EMAIL_FROM="Owsify <no-reply@owsify.local>"
EMAIL_FILE_PATH=./sent-emails
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# --- Gmail ---
# Gmail needs an App Password, not your normal password: Google stopped accepting
# account passwords over SMTP in 2022. An App Password requires 2-Step Verification
# to be on first.
#
#   1. Turn on 2-Step Verification
#      https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password (pick "Mail" / "Other")
#      https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below. Google displays them as "abcd efgh ijkl mnop";
#      the spaces are stripped for you, so either form works.
#
# EMAIL_BACKEND=smtp
# EMAIL_FROM="Owsify <you@gmail.com>"   # must be the SMTP_USER address, see below
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com               # the full address, not just the name
# SMTP_PASSWORD=abcdefghijklmnop        # the App Password, never your login password
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
#
# Port 465 works too, with the TLS flags the other way round:
# SMTP_PORT=465
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true
#
# Gmail only sends as the account you authenticated with. If EMAIL_FROM is any
# other address the app rewrites it to SMTP_USER and logs a warning, because the
# alternative is Google silently rewriting it — or refusing the message outright.
# To send as something else, add it under Gmail → Settings → Accounts and Import →
# "Send mail as" first.
#
# Free Gmail allows roughly 500 recipients a day, Workspace 2,000. That is fine for
# development and small use; a transactional provider is the answer beyond it.

# --- Invitations ---
# Where the invite link points, i.e. the web app rather than this API.
FRONTEND_URL=http://localhost:5173
INVITATION_EXPIRE_DAYS=14

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
